---
import GraphIcon from "../assets/pixel/chart-network.svg";
import Shell from "./Shell.astro";

interface Props {
	wide?: boolean;
}
const { wide } = Astro.props;
---

<Shell>
	<Fragment slot="head"> <slot name="head" /> </Fragment>
	<Fragment slot="body">
		<header id="site-header">
			<nav id="site-nav">
				<ul>
					<li>
						<a href="https://alexanderniebuhr.me" class="nav-link"> me </a>
					</li>
					<li>
						<a
							href={`/${Astro.currentLocale}/graph`}
							aria-label="Graph"
							class="nav-link nav-link-icon"
						>
							<GraphIcon />
						</a>
					</li>
					<li>
						<a href="/" class="nav-link"> x </a>
					</li>
				</ul>
			</nav>
		</header>

		<main class:list={["site-main", { padded: !wide }]}>
			<slot name="main" />
		</main>
		<footer class="site-footer">
			<p>
				© {new Date().getFullYear()}
				<a href="https://alexanderniebuhr.me"> Alexander Niebuhr </a>
			</p>
		</footer>
	</Fragment>
</Shell>

<style>
	@import "../styles/media.css";

	#site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding-block: var(--spacing-fluid-xs);
	}

	#site-nav {
		--nav-bg-a: 0;
		--nav-blur: 0px;
		--nav-shadow-a: 0;
		--nav-shadow-dark-a: 0;
		--nav-ring-a: 0;
		--nav-ring-dark-a: 0;

		border-radius: var(--radius-full);
		padding-inline: var(--spacing-fluid-gutter);
		padding-block: 0.25rem;
		backdrop-filter: blur(var(--nav-blur));

		& ul {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			gap: var(--spacing-fluid-s);
		}
	}

	@keyframes navReveal {
		from {
			--nav-bg-a: 0;
			--nav-blur: 0px;
			--nav-shadow-a: 0;
			--nav-shadow-dark-a: 0;
			--nav-ring-a: 0;
			--nav-ring-dark-a: 0;
		}
		to {
			--nav-bg-a: 0.8;
			--nav-blur: 12px;
			--nav-shadow-a: 0.05;
			--nav-shadow-dark-a: 0.2;
			--nav-ring-a: 0.05;
			--nav-ring-dark-a: 0.1;
		}
	}

	@supports (animation-timeline: scroll()) {
		#site-nav {
			animation: navReveal linear both;
			animation-timeline: scroll(root block);
			animation-range: 0px 50px;
		}
	}

	.nav-link {
		display: inline-block;
		border-radius: var(--radius-full);
		padding-inline: var(--spacing-fluid-xs);
		padding-block: 0.25rem;
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		font-weight: var(--font-weight-medium);
		color: var(--color-neutral-600);
		transition-property: all;
		transition-timing-function: var(--ease-out);
		transition-duration: 200ms;

		@media (--hover) {
			&:hover {
				background-color: var(--color-black-a5);
				color: var(--color-black);
			}
		}

		&:focus-visible {
			outline-style: solid;
			outline-width: 2px;
			outline-offset: 2px;
			outline-color: currentcolor;
		}

		@media (--dark) {
			color: var(--color-neutral-400);

			@media (--hover) {
				&:hover {
					background-color: var(--color-white-a10);
					color: var(--color-white);
				}
			}
		}
	}

	.nav-link-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		@media (--hover) {
			&:hover {
				scale: 110% 110%;
			}
		}
	}

	.site-main {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
		min-height: 0;

		&.padded {
			padding-inline: var(--spacing-fluid-l);
		}
	}

	.site-footer {
		width: 100%;
		padding-block: var(--spacing-fluid-s);
		text-align: center;
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		color: var(--color-neutral-500);

		& a {
			transition-property:
				color, background-color, border-color, outline-color,
				text-decoration-color, fill, stroke;
			transition-timing-function: var(--default-transition-timing-function);
			transition-duration: var(--default-transition-duration);

			@media (--hover) {
				&:hover {
					color: var(--color-neutral-700);
				}
			}
		}

		@media (--dark) {
			color: var(--color-neutral-400);

			@media (--hover) {
				& a:hover {
					color: var(--color-neutral-300);
				}
			}
		}
	}
</style>
