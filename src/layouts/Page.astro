---
import { getRelativeLocaleUrl } from "astro:i18n";
import GraphIcon from "../assets/pixel/chart-network.svg";
import Shell from "./Shell.astro";

interface Props {
	wide?: boolean;
}
const { wide } = Astro.props;
const locale = Astro.currentLocale ?? "en";
const postsHref = getRelativeLocaleUrl(locale);
const graphHref = getRelativeLocaleUrl(locale, "graph");
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
---

<Shell>
	<Fragment slot="head"> <slot name="head" /> </Fragment>
	<Fragment slot="body">
		<a href="#main-content" class="skip-link">Skip to content</a>
		<header id="site-header">
			<nav id="site-nav" aria-label="Main">
				<ul>
					<li>
						<a href="https://alexanderniebuhr.me" class="nav-link">me</a>
					</li>
					<li>
						<a
							href={postsHref}
							aria-current={currentPath === postsHref ? "page" : undefined}
							class="nav-link"
						>
							posts
						</a>
					</li>
					<li>
						<a
							href={graphHref}
							aria-label="Graph"
							aria-current={currentPath === graphHref ? "page" : undefined}
							class="nav-link nav-link-icon"
						>
							<GraphIcon />
						</a>
					</li>
					<li>
						<a
							href="/"
							aria-label="Language selector"
							aria-current={currentPath === "/" ? "page" : undefined}
							class="nav-link"
						>
							x
						</a>
					</li>
				</ul>
			</nav>
		</header>

		<main id="main-content" class:list={["site-main", { padded: !wide }]}>
			<slot name="main" />
		</main>
		<footer class="site-footer">
			<p>
				© {new Date().getFullYear()}
				<a href="https://alexanderniebuhr.me"> Alexander Niebuhr </a>
			</p>
		</footer>
	</Fragment>
</Shell>

<style>
	@import "../styles/media.css";

	#site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding-block: var(--spacing-fluid-xs);
	}

	#site-nav {
		/* Revealed state of the nav, faded in while the page scrolls its first 50px */
		--nav-revealed-bg: light-dark(
			var(--color-amber-50-a80),
			var(--color-neutral-800-a80)
		);
		--nav-revealed-shadow:
			0 0 0 1px light-dark(var(--color-black-a5), var(--color-white-a10)),
			0 10px 15px -3px light-dark(var(--color-black-a5), var(--color-black-a20)),
			0 4px 6px -4px light-dark(var(--color-black-a5), var(--color-black-a20));

		border-radius: var(--radius-full);
		padding-inline: var(--spacing-fluid-gutter);
		padding-block: 0.25rem;
		backdrop-filter: blur(0px);

		& ul {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			gap: var(--spacing-fluid-s);
		}
	}

	@keyframes navReveal {
		from {
			background-color: transparent;
			box-shadow: none;
		}
		to {
			background-color: var(--nav-revealed-bg);
			box-shadow: var(--nav-revealed-shadow);
			backdrop-filter: blur(12px);
		}
	}

	@supports (animation-timeline: scroll()) {
		#site-nav {
			/* Starts after the first scrolled pixel, so the resting nav keeps its plain styles */
			animation: navReveal linear forwards;
			animation-timeline: scroll(root block);
			animation-range: 1px 51px;
		}
	}

	/* Without scroll-driven animations, keep the nav in its revealed state */
	@supports not (animation-timeline: scroll()) {
		#site-nav {
			background-color: var(--nav-revealed-bg);
			box-shadow: var(--nav-revealed-shadow);
			backdrop-filter: blur(12px);
		}
	}

	.nav-link {
		display: inline-block;
		border-radius: var(--radius-full);
		padding-inline: var(--spacing-fluid-xs);
		padding-block: 0.25rem;
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		font-weight: var(--font-weight-medium);
		color: light-dark(var(--color-neutral-600), var(--color-neutral-400));
		transition-property: color, background-color, scale;
		transition-timing-function: var(--ease-out);
		transition-duration: 200ms;

		&[aria-current="page"] {
			color: light-dark(var(--color-black), var(--color-white));
			background-color: light-dark(
				var(--color-black-a5),
				var(--color-white-a10)
			);
		}

		@media (--hover) {
			&:hover {
				background-color: light-dark(
					var(--color-black-a5),
					var(--color-white-a10)
				);
				color: light-dark(var(--color-black), var(--color-white));
			}
		}

		&:focus-visible {
			outline-style: solid;
			outline-width: 2px;
			outline-offset: 2px;
			outline-color: currentcolor;
		}
	}

	.nav-link-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		@media (--hover) {
			&:hover {
				scale: 110% 110%;
			}
		}
	}

	.site-main {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
		min-height: 0;

		&.padded {
			padding-inline: var(--spacing-fluid-l);
		}
	}

	.site-footer {
		width: 100%;
		padding-block: var(--spacing-fluid-s);
		text-align: center;
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		color: light-dark(var(--color-neutral-500), var(--color-neutral-400));

		& a {
			transition-property: color;
			transition-timing-function: var(--default-transition-timing-function);
			transition-duration: var(--default-transition-duration);

			@media (--hover) {
				&:hover {
					color: light-dark(var(--color-neutral-700), var(--color-neutral-300));
				}
			}
		}
	}
</style>
