---
import type { CollectionEntry } from "astro:content";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import cssesc from "cssesc";
import Developing from "../components/icons/Developing.astro";
import Experimental from "../components/icons/Experimental.astro";
import Final from "../components/icons/Final.astro";
import Sharing from "../components/icons/Sharing.astro";
import Understanding from "../components/icons/Understanding.astro";
import PostCover from "../components/PostCover.astro";
import Page from "./Page.astro";

type Post = CollectionEntry<"blog">["data"];
interface Props extends Post {
	postId: string;
	alternateLocales: string[];
}
const { title, postId, alternateLocales, cover, coverAlt } = Astro.props;
const description = `${title} — by ${Astro.props.author}`;

const [lang = "en", ...segments] = postId.split("/");
const localizedPath = segments.join("/");
const canonicalUrl = new URL(`/${postId}/`, Astro.site);
---

<Page>
	<Fragment slot="head">
		<title>{title}</title>
		<meta name="description" content={description}>
		<link rel="canonical" href={canonicalUrl.href}>
		{alternateLocales.length > 1 &&
			alternateLocales.map((locale) => (
				<link
					rel="alternate"
					hreflang={locale}
					href={getAbsoluteLocaleUrl(locale, `${localizedPath}/`)}
				/>
			))}
		<!-- Open Graph -->
		<meta property="og:type" content="website">
		<meta property="og:url" content={canonicalUrl.href}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:locale" content={lang}>
		<meta property="og:site_name" content="Alexander Niebuhr's Garden">
		<!-- Twitter -->
		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
	</Fragment>
	<Fragment slot="main">
		<article class="post">
			<header class="post-header">
				<time class="post-date" datetime={Astro.props.date.toISOString()}>
					{Astro.props.date.toLocaleDateString("de-DE")}
				</time>
				<h1
					class="post-title"
					style={{
						"view-transition-name": cssesc(title, { isIdentifier: true }),
					}}
				>
					{title}
				</h1>
				{/* biome-ignore lint/a11y/useSemanticElements: a <fieldset> brings default border, padding and min-width styling and is meant for form controls; role="group" with aria-label is valid ARIA here */}
				<div role="group" aria-label="Post maturity stages" class="stages">
					<button
						class="stage"
						style="anchor-name: --stage-experimental"
						popovertarget="tip-experimental"
						type="button"
					>
						<Experimental type="multi" width="2rem" height="2rem" />
					</button>
					<div
						id="tip-experimental"
						popover
						class="stage-tip"
						style="position-anchor: --stage-experimental"
					>
						<strong>Experimental</strong>
						<p>Early seedling — a raw idea, just planted.</p>
					</div>
					&centerdot;
					<button
						class="stage"
						style="anchor-name: --stage-developing"
						popovertarget="tip-developing"
						type="button"
					>
						<Developing
							type="multi"
							width="2rem"
							height="2rem"
							class="stage-icon-muted"
						/>
					</button>
					<div
						id="tip-developing"
						popover
						class="stage-tip"
						style="position-anchor: --stage-developing"
					>
						<strong>Developing</strong>
						<p>Growing — being actively worked on.</p>
					</div>
					&centerdot;
					<button
						class="stage"
						style="anchor-name: --stage-understanding"
						popovertarget="tip-understanding"
						type="button"
					>
						<Understanding
							type="multi"
							width="2rem"
							height="2rem"
							class="stage-icon-muted"
						/>
					</button>
					<div
						id="tip-understanding"
						popover
						class="stage-tip"
						style="position-anchor: --stage-understanding"
					>
						<strong>Understanding</strong>
						<p>Maturing — deepening insight on the topic.</p>
					</div>
					&centerdot;
					<button
						class="stage"
						style="anchor-name: --stage-sharing"
						popovertarget="tip-sharing"
						type="button"
					>
						<Sharing
							type="multi"
							width="2rem"
							height="2rem"
							class="stage-icon-muted"
						/>
					</button>
					<div
						id="tip-sharing"
						popover
						class="stage-tip"
						style="position-anchor: --stage-sharing"
					>
						<strong>Sharing</strong>
						<p>Ready to share — polished enough for others.</p>
					</div>
					&centerdot;
					<button
						class="stage"
						style="anchor-name: --stage-final"
						popovertarget="tip-final"
						type="button"
					>
						<Final
							type="multi"
							width="2rem"
							height="2rem"
							class="stage-icon-muted"
						/>
					</button>
					<div
						id="tip-final"
						popover
						class="stage-tip"
						style="position-anchor: --stage-final"
					>
						<strong>Final</strong>
						<p>Evergreen — considered complete.</p>
					</div>
				</div>
			</header>
			<div class="post-cover">
				<PostCover
					postId={postId}
					src={cover}
					alt={coverAlt}
					sizes="(max-width: 68rem) 88vw, 64rem"
					priority
				/>
			</div>
			<div class="prose"><slot /></div>
		</article>
	</Fragment>
</Page>

<style>
	@import "../styles/media.css";

	.post {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-fluid-m);
		padding-inline: var(--spacing-fluid-l);
	}

	.post-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-fluid-xs);
	}

	.post-date {
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		color: light-dark(var(--color-neutral-500), var(--color-neutral-400));
	}

	.post-cover {
		width: min(100%, 64rem);
		margin-inline: auto;

		& :global(img) {
			width: 100%;
			height: auto;
		}
	}

	.post-title {
		font-size: var(--text-fluid-heading);
		line-height: var(--text-fluid-heading--line-height);
		font-weight: var(--font-weight-bold);
		text-align: center;
		width: fit-content;
	}

	.stages {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		user-select: none;
	}

	.stage {
		display: inline-flex;
		cursor: help;
		border-radius: var(--radius-sm);
		padding: 0.125rem;
		outline-style: none;

		&:focus-visible {
			outline-style: solid;
			outline-width: 2px;
			outline-offset: 2px;
			outline-color: var(--color-neutral-400);
		}
	}

	.stage-icon-muted {
		filter: grayscale(100%);
	}

	.stage-tip {
		position: fixed;
		position-area: block-end;
		margin: 0;
		width: max-content;
		max-width: 14rem;
		padding-inline: 0.75rem;
		padding-block: 0.5rem;
		border: 1px solid
			light-dark(var(--color-neutral-200), var(--color-neutral-700));
		border-radius: var(--radius-lg);
		background-color: light-dark(var(--color-white), var(--color-neutral-800));
		color: light-dark(var(--color-neutral-700), var(--color-neutral-200));
		font-size: 0.8125rem;
		line-height: 1.4;
		box-shadow: 0 4px 12px light-dark(rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.3));
		opacity: 0;
		translate: 0 -0.25rem;
		transition:
			opacity 150ms ease,
			translate 150ms ease,
			overlay 150ms ease allow-discrete,
			display 150ms ease allow-discrete;

		&:is([open], :popover-open, :open) {
			opacity: 1;
			translate: 0 0.25rem;
		}

		& strong {
			display: block;
			margin-bottom: 0.125rem;
			font-weight: var(--font-weight-semibold);
			color: light-dark(var(--color-neutral-900), var(--color-white));
		}

		& p {
			margin: 0;
		}

		@starting-style {
			&:is([open], :popover-open, :open) {
				opacity: 0;
				translate: 0 -0.25rem;
			}
		}
	}
</style>
