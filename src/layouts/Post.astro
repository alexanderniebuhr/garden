---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import cssesc from "cssesc";
import Developing from "../components/icons/Developing.astro";
import Experimental from "../components/icons/Experimental.astro";
import Final from "../components/icons/Final.astro";
import Sharing from "../components/icons/Sharing.astro";
import Understanding from "../components/icons/Understanding.astro";
import PostCover from "../components/PostCover.astro";
import { getPostUrl } from "../posts";
import { POST_STATES, type PostState, STATE_META } from "../states";
import Page from "./Page.astro";

type PostData = CollectionEntry<"blog">["data"];

interface RelatedPost {
	id: string;
	title: string;
	date: Date;
}

interface Props extends PostData {
	postId: string;
	alternateLocales: string[];
	relatedPosts: RelatedPost[];
}

const {
	title,
	author,
	date,
	state,
	cover,
	coverAlt,
	excerpt,
	postId,
	alternateLocales,
	relatedPosts,
} = Astro.props;

const description = excerpt ?? `${title} — by ${author}`;

const [lang = "en", ...segments] = postId.split("/");
const localizedPath = segments.join("/");
const canonicalUrl = new URL(getPostUrl(postId), Astro.site);
const ogCover = await getImage({ src: cover, width: 1200, format: "jpeg" });
const ogImageUrl = new URL(ogCover.src, Astro.site);

const stageIcons: Record<PostState, typeof Experimental> = {
	experimental: Experimental,
	building: Developing,
	idea: Understanding,
	sharing: Sharing,
	final: Final,
};

const stages = POST_STATES.map((key) => ({
	key,
	...STATE_META[key],
	Icon: stageIcons[key],
	isCurrent: key === state,
}));

const titleTransitionName = cssesc(`post-title-${postId}`, {
	isIdentifier: true,
});
---

<Page>
	<Fragment slot="head">
		<title>{title} — Alexander Niebuhr's Garden</title>
		<meta name="description" content={description}>
		<link rel="canonical" href={canonicalUrl.href}>
		{alternateLocales.length > 1 &&
			alternateLocales.map((locale) => (
				<link
					rel="alternate"
					hreflang={locale}
					href={getAbsoluteLocaleUrl(locale, `${localizedPath}/`)}
				/>
			))}
		<!-- Open Graph -->
		<meta property="og:type" content="article">
		<meta property="og:url" content={canonicalUrl.href}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={ogImageUrl.href}>
		<meta property="og:image:alt" content={coverAlt}>
		<meta property="og:locale" content={lang}>
		{alternateLocales
			.filter((locale) => locale !== lang)
			.map((locale) => (
				<meta property="og:locale:alternate" content={locale} />
			))}
		<meta property="og:site_name" content="Alexander Niebuhr's Garden">
		<meta property="article:published_time" content={date.toISOString()}>
		<meta property="article:author" content={author}>
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImageUrl.href}>
		<meta name="twitter:image:alt" content={coverAlt}>
	</Fragment>
	<Fragment slot="main">
		<article class="post">
			<header class="post-header">
				<time class="post-date" datetime={date.toISOString()}>
					{date.toLocaleDateString(lang, {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
				<h1
					class="post-title"
					style={{ "view-transition-name": titleTransitionName }}
				>
					{title}
				</h1>
				{/* biome-ignore lint/a11y/useSemanticElements: a <fieldset> brings default border, padding and min-width styling and is meant for form controls; role="group" with aria-label is valid ARIA here */}
				<div role="group" aria-label="Post maturity stages" class="stages">
					{stages.map((stage, index) => {
						const Icon = stage.Icon;
						const tipId = `tip-${stage.key}`;
						const anchorName = `--stage-${stage.key}`;
						return (
							<>
								{index > 0 && <span aria-hidden="true">&centerdot;</span>}
								<button
									class="stage"
									style={`anchor-name: ${anchorName}`}
									popovertarget={tipId}
									aria-label={
										stage.isCurrent
											? `${stage.label} (current stage)`
											: stage.label
									}
									aria-current={stage.isCurrent ? "step" : undefined}
									type="button"
								>
									<Icon
										type="multi"
										width="2rem"
										height="2rem"
										aria-hidden="true"
										class={stage.isCurrent ? undefined : "stage-icon-muted"}
									/>
								</button>
								<div
									id={tipId}
									popover
									class="stage-tip"
									style={`position-anchor: ${anchorName}`}
								>
									<strong>
										{stage.label}
										{stage.isCurrent && (
											<span class="stage-current-badge">Current</span>
										)}
									</strong>
									<p>{stage.description}</p>
								</div>
							</>
						);
					})}
				</div>
			</header>
			<div class="post-cover">
				<PostCover
					postId={postId}
					src={cover}
					alt={coverAlt}
					sizes="(max-width: 68rem) 88vw, 64rem"
					priority
				/>
			</div>
			<div class="prose post-prose"><slot /></div>
			{relatedPosts.length > 0 && (
				<aside aria-labelledby="related-heading" class="related-posts">
					<h2 id="related-heading" class="related-heading">
						Related posts
					</h2>
					<ul class="related-list">
						{relatedPosts.map((related) => (
							<li>
								<a href={getPostUrl(related.id)} class="related-link">
									<span>{related.title}</span>
									<time datetime={related.date.toISOString()}>
										{related.date.toLocaleDateString(lang, {
											year: "numeric",
											month: "short",
											day: "numeric",
										})}
									</time>
								</a>
							</li>
						))}
					</ul>
				</aside>
			)}
		</article>
	</Fragment>
</Page>

<style>
	@import "../styles/media.css";

	.post {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-fluid-m);
	}

	.post-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-fluid-xs);
	}

	.post-date {
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		color: light-dark(var(--color-neutral-500), var(--color-neutral-400));
	}

	.post-cover {
		width: min(100%, 64rem);
		margin-inline: auto;

		& :global(img) {
			width: 100%;
			height: auto;
		}
	}

	.post-prose {
		width: min(100%, 45rem);
		margin-inline: auto;
	}

	.post-title {
		font-size: var(--text-fluid-heading);
		line-height: var(--text-fluid-heading--line-height);
		font-weight: var(--font-weight-bold);
		text-align: center;
		width: fit-content;
		max-width: min(100%, 45rem);
	}

	.stages {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		user-select: none;
	}

	.stage {
		display: inline-flex;
		cursor: help;
		border-radius: var(--radius-sm);
		padding: 0.125rem;
		outline-style: none;

		&:focus-visible {
			outline-style: solid;
			outline-width: 2px;
			outline-offset: 2px;
			outline-color: var(--color-neutral-400);
		}
	}

	.stage-icon-muted {
		filter: grayscale(100%);
	}

	.stage-tip {
		position: fixed;
		position-area: block-end;
		margin: 0;
		width: max-content;
		max-width: 14rem;
		padding-inline: 0.75rem;
		padding-block: 0.5rem;
		border: 1px solid
			light-dark(var(--color-neutral-200), var(--color-neutral-700));
		border-radius: var(--radius-lg);
		background-color: light-dark(var(--color-white), var(--color-neutral-800));
		color: light-dark(var(--color-neutral-700), var(--color-neutral-200));
		font-size: 0.8125rem;
		line-height: 1.4;
		box-shadow: 0 4px 12px light-dark(rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.3));
		opacity: 0;
		translate: 0 -0.25rem;
		transition:
			opacity 150ms ease,
			translate 150ms ease,
			overlay 150ms ease allow-discrete,
			display 150ms ease allow-discrete;

		&:is([open], :popover-open, :open) {
			opacity: 1;
			translate: 0 0.25rem;
		}

		& strong {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			margin-bottom: 0.125rem;
			font-weight: var(--font-weight-semibold);
			color: light-dark(var(--color-neutral-900), var(--color-white));
		}

		& p {
			margin: 0;
		}

		@starting-style {
			&:is([open], :popover-open, :open) {
				opacity: 0;
				translate: 0 -0.25rem;
			}
		}
	}

	.stage-current-badge {
		border-radius: var(--radius-full);
		background-color: light-dark(
			var(--color-neutral-200),
			var(--color-neutral-700)
		);
		padding-inline: 0.375rem;
		padding-block: 0.0625rem;
		font-size: 0.6875rem;
		font-weight: var(--font-weight-medium);
		color: light-dark(var(--color-neutral-700), var(--color-neutral-200));
	}

	.related-posts {
		width: min(100%, 45rem);
		margin-inline: auto;
		border-top: 1px solid
			light-dark(var(--color-neutral-200), var(--color-neutral-800));
		padding-top: var(--spacing-fluid-s);
	}

	.related-heading {
		margin-bottom: var(--spacing-fluid-xs);
		font-size: var(--text-sm);
		line-height: var(--text-sm--line-height);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: light-dark(var(--color-neutral-500), var(--color-neutral-400));
	}

	.related-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.related-link {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		border-radius: var(--radius-lg);
		padding-inline: 0.75rem;
		padding-block: 0.5rem;
		font-weight: var(--font-weight-medium);
		transition-property: background-color;
		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: var(--default-transition-duration);

		& time {
			font-size: var(--text-xs);
			line-height: var(--text-xs--line-height);
			color: light-dark(var(--color-neutral-500), var(--color-neutral-400));
		}

		@media (--hover) {
			&:hover {
				background-color: light-dark(
					var(--color-neutral-200-a50),
					var(--color-neutral-800-a50)
				);
			}
		}

		&:focus-visible {
			outline: 2px solid currentcolor;
			outline-offset: 2px;
		}
	}
</style>
