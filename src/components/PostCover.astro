---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import cssesc from "cssesc";

interface Props {
	postId: string;
	src: ImageMetadata;
	alt: string;
	sizes: string;
	priority?: boolean;
}

const { postId, src, alt, sizes, priority = false } = Astro.props;
const transitionName = cssesc(`post-cover-${postId}`, { isIdentifier: true });
---

<Picture
	src={src}
	alt={alt}
	formats={["avif", "webp"]}
	quality="high"
	layout="constrained"
	sizes={sizes}
	priority={priority}
	style={{ "view-transition-name": transitionName }}
/>
