---
export const prerender = true;

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getPublishedPosts } from "../../posts";

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	const publishedIds = new Set(posts.map(({ id }) => id));
	return posts.map((post) => {
		for (const { id } of post.data.related) {
			if (!publishedIds.has(id)) {
				throw new Error(
					`${post.id} references an unpublished or missing post: ${id}`,
				);
			}
		}
		const [lang, ...id] = post.id.split("/");
		return {
			params: {
				locale: lang,
				id: id.join("/") || undefined,
			},
			props: post,
		};
	});
}) satisfies GetStaticPaths;

// type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const post = Astro.props;
const { Content } = await render(post);
---

<Post {...post.data}> <Content /> </Post>
