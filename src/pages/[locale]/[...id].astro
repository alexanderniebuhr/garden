---
export const prerender = true;

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getPublishedPosts } from "../../posts";

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	const publishedIds = new Set(posts.map(({ id }) => id));
	const localesByPath = new Map<string, string[]>();
	for (const { id } of posts) {
		const [locale, ...segments] = id.split("/");
		if (!locale) continue;
		const path = segments.join("/");
		const locales = localesByPath.get(path) ?? [];
		locales.push(locale);
		localesByPath.set(path, locales);
	}
	return posts.map((post) => {
		for (const { id } of post.data.related) {
			if (!publishedIds.has(id)) {
				throw new Error(
					`${post.id} references an unpublished or missing post: ${id}`,
				);
			}
		}
		const [locale, ...segments] = post.id.split("/");
		const path = segments.join("/");
		return {
			params: {
				locale,
				id: path || undefined,
			},
			props: { post, alternateLocales: localesByPath.get(path) ?? [] },
		};
	});
}) satisfies GetStaticPaths;

// type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, alternateLocales } = Astro.props;
const { Content } = await render(post);
---

<Post {...post.data} postId={post.id} alternateLocales={alternateLocales}>
	<Content />
</Post>
