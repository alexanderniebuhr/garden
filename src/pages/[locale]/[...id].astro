---
export const prerender = true;

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getPublishedPosts } from "../../posts";

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	const postsById = new Map(posts.map((post) => [post.id, post]));
	const localesByPath = new Map<string, string[]>();
	for (const { id } of posts) {
		const [locale, ...segments] = id.split("/");
		if (!locale) continue;
		const path = segments.join("/");
		const locales = localesByPath.get(path) ?? [];
		locales.push(locale);
		localesByPath.set(path, locales);
	}
	return posts.map((post) => {
		const relatedPosts = post.data.related.map(({ id }) => {
			const relatedPost = postsById.get(id);
			if (!relatedPost) {
				throw new Error(
					`${post.id} references an unpublished or missing post: ${id}`,
				);
			}
			return {
				id: relatedPost.id,
				title: relatedPost.data.title,
				date: relatedPost.data.date,
			};
		});
		const [locale, ...segments] = post.id.split("/");
		const path = segments.join("/");
		return {
			params: {
				locale,
				id: path || undefined,
			},
			props: {
				post,
				alternateLocales: localesByPath.get(path) ?? [],
				relatedPosts,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, alternateLocales, relatedPosts } = Astro.props;
const { Content } = await render(post);
---

<Post
	{...post.data}
	postId={post.id}
	alternateLocales={alternateLocales}
	relatedPosts={relatedPosts}
>
	<Content />
</Post>
