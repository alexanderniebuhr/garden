---
export const prerender = true;

import { getRelativeLocaleUrl } from "astro:i18n";
import Page from "../layouts/Page.astro";

const locale = Astro.currentLocale ?? "en";
---

<Page>
	<Fragment slot="head">
		<title>Not Found — Alexander Niebuhr's Garden</title>
		<meta name="robots" content="noindex">
	</Fragment>
	<Fragment slot="main">
		<section class="not-found">
			<p class="not-found-code">404</p>
			<h1 class="not-found-title">Page not found</h1>
			<p class="not-found-message">
				Sorry, the page you are looking for does not exist.
			</p>
			<a href={getRelativeLocaleUrl(locale)} class="not-found-link">
				Browse posts
			</a>
		</section>
	</Fragment>
</Page>

<style>
	@import "../styles/media.css";

	.not-found {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-fluid-xs);
		text-align: center;
	}

	.not-found-code {
		font-size: var(--text-xs);
		line-height: var(--text-xs--line-height);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: light-dark(var(--color-neutral-500), var(--color-neutral-400));
	}

	.not-found-title {
		font-size: var(--text-fluid-heading);
		line-height: var(--text-fluid-heading--line-height);
		font-weight: var(--font-weight-bold);
	}

	.not-found-message {
		max-width: 28rem;
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
		color: light-dark(var(--color-neutral-600), var(--color-neutral-400));
	}

	.not-found-link {
		margin-top: var(--spacing-fluid-xs);
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-full);
		background-color: var(--color-yellow-400);
		color: var(--color-gray-900);
		padding-inline: 1.25rem;
		padding-block: 0.625rem;
		font-size: var(--text-xs);
		line-height: var(--text-xs--line-height);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		transition-property: background-color;
		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: var(--default-transition-duration);

		@media (--hover) {
			&:hover {
				background-color: var(--color-yellow-500);
			}
		}

		&:focus-visible {
			outline: 2px solid currentcolor;
			outline-offset: 2px;
		}
	}
</style>
