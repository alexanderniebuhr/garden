---
export const prerender = false;

import Page from "../../layouts/Page.astro";
import { getPostUrl, getPublishedPosts } from "../../posts";
import { POST_STATES, type PostState, STATE_META } from "../../states";

const locale = Astro.currentLocale ?? "en";
const posts = await getPublishedPosts(locale);
const canonicalUrl = new URL(`/${locale}/graph/`, Astro.site);

interface NodeData {
	id: string;
	label: string;
	state: PostState;
	radius: number;
	color: number;
	href: string;
}

interface LinkData {
	source: string;
	target: string;
}

const nodes: NodeData[] = posts.map((post) => ({
	id: post.id,
	label: post.data.title,
	state: post.data.state,
	radius: 30,
	color: STATE_META[post.data.state].pixi,
	href: getPostUrl(post.id),
}));

const links: LinkData[] = [];
const seenEdges = new Set<string>();
const postSlugs = new Map(posts.map((p) => [p.data.slug, p.id]));
const postIds = new Set(posts.map((p) => p.id));
const linkRegex = /\[.*?\]\((.*?)\)/g;

function addLink(source: string, target: string) {
	if (source === target || !postIds.has(target)) return;
	const edgeKey =
		source < target ? `${source}\0${target}` : `${target}\0${source}`;
	if (seenEdges.has(edgeKey)) return;
	seenEdges.add(edgeKey);
	links.push({ source, target });
}

for (const post of posts) {
	for (const related of post.data.related) {
		addLink(post.id, related.id);
	}

	const matches = post.body?.matchAll(linkRegex) ?? [];
	for (const match of matches) {
		const href = match[1];
		if (!href) continue;
		const normalized = href.replace(/^\/|\/$/g, "");
		const targetId =
			postSlugs.get(normalized) ??
			(postIds.has(normalized) ? normalized : undefined);
		if (targetId) {
			addLink(post.id, targetId);
		}
	}
}

const graphDataJson = JSON.stringify({ nodes, links }).replaceAll(
	"<",
	"\\u003c",
);

const legendItems = POST_STATES.map((key) => ({
	key,
	label: STATE_META[key].label,
	hex: STATE_META[key].hex,
}));
---

<Page>
	<Fragment slot="head">
		<title>Graph — Alexander Niebuhr's Garden</title>
		<meta
			name="description"
			content="Interactive graph of connected posts and maturity stages in Alexander Niebuhr's digital garden."
		>
		<link rel="canonical" href={canonicalUrl.href}>
	</Fragment>
	<Fragment slot="main">
		<section id="graph-container" aria-label="Post relationship graph">
			<canvas
				id="graph"
				aria-label="Interactive force-directed graph of published posts"
			></canvas>

			{nodes.length === 0 && (
				<p class="graph-empty">No published posts in this locale yet.</p>
			)}

			<!-- Legend / Filter -->
			<div id="legend">
				<div class="legend-title">Filter</div>
				<div class="legend-list">
					{legendItems.map((s) => (
						<button
							type="button"
							data-state={s.key}
							aria-pressed="true"
							class="legend-filter"
						>
							<span class="legend-dot" style={`--dot-color:${s.hex}`} />
							<span class="legend-label">{s.label}</span>
						</button>
					))}
				</div>
			</div>

			<!-- Reset button -->
			<button type="button" id="reset-view">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
					<path d="M21 3v5h-5" />
				</svg>
				Reset
			</button>
		</section>

		<script
			is:inline
			id="__graphData"
			type="application/json"
			set:html={graphDataJson}
		></script>

		<script>
			import type { SimulationLinkDatum, SimulationNodeDatum } from "d3";
			import {
				forceCenter,
				forceCollide,
				forceLink,
				forceManyBody,
				forceSimulation,
			} from "d3";
			import {
				Application,
				Circle,
				ColorMatrixFilter,
				Container,
				type FederatedPointerEvent,
				Graphics,
				Text,
			} from "pixi.js";
			import { STATE_ICON_SVGS } from "../../state-icons";
			import { type PostState, STATE_META } from "../../states";

			(async () => {
				interface GraphNode extends SimulationNodeDatum {
					id: string;
					label: string;
					state: PostState;
					radius: number;
					color: number;
					href: string;
				}

				// The serialized links reference nodes by id; forceLink below
				// replaces source/target with the node objects when the
				// simulation is created, before anything reads them.
				interface GraphLink extends SimulationLinkDatum<GraphNode> {
					source: GraphNode;
					target: GraphNode;
				}

				interface GraphData {
					nodes: GraphNode[];
					links: GraphLink[];
				}

				const graphDataText =
					document.getElementById("__graphData")?.textContent;
				if (!graphDataText) {
					throw new Error("Missing #__graphData payload");
				}
				const { nodes, links }: GraphData = JSON.parse(graphDataText);

				const canvasEl = document.getElementById("graph");
				const containerEl = document.getElementById("graph-container");
				if (
					!(canvasEl instanceof HTMLCanvasElement) ||
					!(containerEl instanceof HTMLElement)
				) {
					return;
				}
				const canvas = canvasEl;
				const container = containerEl;

				const app = new Application();
				await app.init({
					canvas,
					resizeTo: container,
					antialias: true,
					backgroundAlpha: 0,
					powerPreference: "low-power",
					resolution: window.devicePixelRatio || 1,
					autoDensity: true,
					preference: "webgpu",
				});

				// World container for pan/zoom
				const world = new Container();
				app.stage.addChild(world);

				// Layer ordering: links → glows → nodes → labels
				const linkLayer = new Graphics();
				world.addChild(linkLayer);

				const glowLayer = new Container();
				world.addChild(glowLayer);

				const nodeLayer = new Container();
				world.addChild(nodeLayer);

				const labelLayer = new Container();
				world.addChild(labelLayer);

				// Theme-reactive colors
				const darkModeQuery = window.matchMedia("(prefers-color-scheme: dark)");
				let labelColor = darkModeQuery.matches ? 0xd4d4d4 : 0x404040;
				let linkColor = darkModeQuery.matches ? 0x666666 : 0xaaaaaa;

				interface NodeVisuals {
					glow: Graphics;
					graphic: Graphics;
					label: Text;
					node: GraphNode;
					baseScale: number;
				}

				const nodeVisualsById = new Map<string, NodeVisuals>();

				const grayscaleFilter = new ColorMatrixFilter();
				grayscaleFilter.desaturate();

				const disabledStates = new Set<string>();

				for (const n of nodes) {
					const glow = new Graphics();
					glow.circle(0, 0, n.radius + 2);
					glow.fill({ color: n.color, alpha: 0.15 });
					glow.circle(0, 0, n.radius - 4);
					glow.fill({ color: n.color, alpha: 0.25 });
					glowLayer.addChild(glow);

					const svgString =
						STATE_ICON_SVGS[n.state] ??
						'<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80"></svg>';
					const graphic = new Graphics().svg(svgString);
					const desiredSize = n.radius * 1.2;
					const svgSize = 40;
					const scale = desiredSize / svgSize;
					graphic.scale.set(scale);
					graphic.pivot.set(svgSize / 2, svgSize / 2);
					// Make hover/click/drag react on the full circular node area, not just visible SVG paths.
					graphic.hitArea = new Circle(
						svgSize / 2,
						svgSize / 2,
						(n.radius + 8) / scale,
					);
					graphic.eventMode = "static";
					graphic.cursor = "pointer";
					const baseScale = graphic.scale.x;
					nodeLayer.addChild(graphic);

					const label = new Text({
						text: n.label,
						style: {
							fontSize: 12,
							fill: labelColor,
							fontFamily: "system-ui, -apple-system, sans-serif",
							fontWeight: "500",
							align: "center",
						},
					});
					label.anchor.set(0.5, -0.5);
					labelLayer.addChild(label);

					nodeVisualsById.set(n.id, {
						glow,
						graphic,
						label,
						node: n,
						baseScale,
					});
				}

				// ---- D3 Force Simulation ----
				const cx = container.clientWidth / 2;
				const cy = container.clientHeight / 2;

				const sim = forceSimulation<GraphNode>(nodes)
					.force(
						"link",
						forceLink<GraphNode, GraphLink>(links)
							.id((d) => d.id)
							.distance(140),
					)
					.force("charge", forceManyBody().strength(-250))
					.force(
						"collide",
						forceCollide<GraphNode>().radius((d) => d.radius + 16),
					)
					.force("center", forceCenter(cx, cy))
					.alphaDecay(0.02);

				// Precompute adjacency map once forceLink has resolved source/target nodes
				const neighborsById = new Map<string, Set<string>>();
				for (const l of links) {
					let sourceNeighbors = neighborsById.get(l.source.id);
					if (!sourceNeighbors) {
						sourceNeighbors = new Set();
						neighborsById.set(l.source.id, sourceNeighbors);
					}
					sourceNeighbors.add(l.target.id);

					let targetNeighbors = neighborsById.get(l.target.id);
					if (!targetNeighbors) {
						targetNeighbors = new Set();
						neighborsById.set(l.target.id, targetNeighbors);
					}
					targetNeighbors.add(l.source.id);
				}

				// ---- Pan & Zoom ----
				let pan = { x: 0, y: 0 };
				let zoom = 1;

				function clampPan() {
					if (nodeVisualsById.size === 0) return;
					const vw = container.clientWidth;
					const vh = container.clientHeight;
					let minX = Infinity;
					let minY = Infinity;
					let maxX = -Infinity;
					let maxY = -Infinity;
					for (const nv of nodeVisualsById.values()) {
						const r = nv.node.radius + 20;
						const nx = nv.node.x ?? 0;
						const ny = nv.node.y ?? 0;
						minX = Math.min(minX, nx - r);
						minY = Math.min(minY, ny - r);
						maxX = Math.max(maxX, nx + r);
						maxY = Math.max(maxY, ny + r);
					}
					const margin = 100;
					const contentRight = maxX * zoom + pan.x;
					const contentLeft = minX * zoom + pan.x;
					const contentBottom = maxY * zoom + pan.y;
					const contentTop = minY * zoom + pan.y;

					if (contentRight < margin) pan.x += margin - contentRight;
					if (contentLeft > vw - margin) pan.x -= contentLeft - (vw - margin);
					if (contentBottom < margin) pan.y += margin - contentBottom;
					if (contentTop > vh - margin) pan.y -= contentTop - (vh - margin);
				}

				function applyTransform() {
					clampPan();
					world.position.set(pan.x, pan.y);
					world.scale.set(zoom);
				}

				canvas.addEventListener(
					"wheel",
					(e) => {
						e.preventDefault();
						const rect = canvas.getBoundingClientRect();
						const mx = e.clientX - rect.left;
						const my = e.clientY - rect.top;

						const oldZoom = zoom;
						const factor = e.deltaY < 0 ? 1.08 : 1 / 1.08;
						zoom = Math.min(Math.max(zoom * factor, 0.15), 6);

						const wxBefore = (mx - pan.x) / oldZoom;
						const wyBefore = (my - pan.y) / oldZoom;
						pan.x = mx - wxBefore * zoom;
						pan.y = my - wyBefore * zoom;

						applyTransform();
						requestRender();
					},
					{ passive: false },
				);

				// ---- Panning (background drag) ----
				let isPanning = false;
				let isDraggingNode = false;
				let isNodePointerDown = false;
				let activePanPointerId: number | null = null;
				let panStart = { x: 0, y: 0 };
				let panMouseStart = { x: 0, y: 0 };
				const PAN_START_DISTANCE = 6;
				const NODE_DRAG_START_DISTANCE = 10;

				canvas.addEventListener("pointerdown", (e) => {
					if (isDraggingNode || isNodePointerDown) return;
					activePanPointerId = e.pointerId;
					isPanning = false;
					panStart = { ...pan };
					panMouseStart = { x: e.clientX, y: e.clientY };
				});

				canvas.addEventListener("pointermove", (e) => {
					if (
						activePanPointerId !== e.pointerId ||
						isDraggingNode ||
						isNodePointerDown
					) {
						return;
					}

					const dx = e.clientX - panMouseStart.x;
					const dy = e.clientY - panMouseStart.y;
					const panDistance = Math.hypot(dx, dy);

					if (!isPanning) {
						if (panDistance < PAN_START_DISTANCE) return;
						isPanning = true;
						canvas.style.cursor = "grabbing";
					}

					pan.x = panStart.x + dx;
					pan.y = panStart.y + dy;
					applyTransform();
					requestRender();
				});

				canvas.addEventListener("pointerup", (e) => {
					if (activePanPointerId !== e.pointerId) return;
					isPanning = false;
					activePanPointerId = null;
					if (!isDraggingNode && !isNodePointerDown)
						canvas.style.cursor = "grab";
				});

				canvas.addEventListener("pointerleave", () => {
					isPanning = false;
					activePanPointerId = null;
					if (!isDraggingNode && !isNodePointerDown)
						canvas.style.cursor = "grab";
				});

				// ---- Node Drag ----
				let dragged: GraphNode | null = null;
				let pressedNode: GraphNode | null = null;
				let activeNodePointerId: number | null = null;
				let pointerDownPos = { x: 0, y: 0 };
				let nodeInteractionMoved = false;

				for (const { graphic, node } of nodeVisualsById.values()) {
					graphic.on("pointerdown", (ev: FederatedPointerEvent) => {
						ev.stopPropagation();
						pressedNode = node;
						activeNodePointerId = ev.pointerId;
						isNodePointerDown = true;
						isDraggingNode = false;
						nodeInteractionMoved = false;
						dragged = null;

						pointerDownPos = { x: ev.globalX, y: ev.globalY };

						isPanning = false;
						activePanPointerId = null;
						canvas.style.cursor = "grabbing";
					});
				}

				app.stage.eventMode = "static";
				app.stage.hitArea = app.screen;

				app.stage.on("pointermove", (ev: FederatedPointerEvent) => {
					if (
						!pressedNode ||
						activeNodePointerId === null ||
						ev.pointerId !== activeNodePointerId
					) {
						return;
					}

					if (!isDraggingNode) {
						const dx = ev.globalX - pointerDownPos.x;
						const dy = ev.globalY - pointerDownPos.y;
						const dragDistance = Math.hypot(dx, dy);
						if (dragDistance < NODE_DRAG_START_DISTANCE) return;

						isDraggingNode = true;
						nodeInteractionMoved = true;
						dragged = pressedNode;
						sim.alphaTarget(0.3).restart();
					}

					if (!dragged) return;

					const wp = world.toLocal(ev.global);
					dragged.fx = wp.x;
					dragged.fy = wp.y;
					sim.alpha(0.3).restart();
				});

				function releaseNode(ev?: FederatedPointerEvent) {
					if (
						ev &&
						activeNodePointerId !== null &&
						ev.pointerId !== activeNodePointerId
					) {
						return;
					}

					if (dragged) {
						dragged.fx = null;
						dragged.fy = null;
						sim.alphaTarget(0);
					}
					dragged = null;
					pressedNode = null;
					activeNodePointerId = null;
					isDraggingNode = false;
					isNodePointerDown = false;
					canvas.style.cursor = "grab";
				}

				app.stage.on("pointerup", releaseNode);
				app.stage.on("pointerupoutside", releaseNode);

				// ---- Click to navigate ----
				for (const { graphic, node } of nodeVisualsById.values()) {
					graphic.on("pointertap", () => {
						if (isDraggingNode || nodeInteractionMoved) {
							nodeInteractionMoved = false;
							return;
						}
						window.location.href = node.href;
					});
				}

				// ---- Hover effects ----
				let hoveredNodeId: string | null = null;

				for (const nv of nodeVisualsById.values()) {
					const { graphic, node } = nv;
					graphic.on("pointerenter", () => {
						hoveredNodeId = node.id;

						nv.graphic.scale.set(nv.baseScale * 1.2);
						nv.glow.clear();
						nv.glow.circle(0, 0, node.radius + 8);
						nv.glow.fill({ color: node.color, alpha: 0.3 });
						nv.glow.circle(0, 0, node.radius);
						nv.glow.fill({ color: node.color, alpha: 0.5 });

						requestRender();
					});

					graphic.on("pointerleave", () => {
						hoveredNodeId = null;

						nv.graphic.scale.set(nv.baseScale);
						nv.glow.clear();
						nv.glow.circle(0, 0, node.radius + 2);
						nv.glow.fill({ color: node.color, alpha: 0.15 });
						nv.glow.circle(0, 0, node.radius - 4);
						nv.glow.fill({ color: node.color, alpha: 0.25 });

						requestRender();
					});
				}

				// ---- Rendering ----
				let needsRender = true;
				function requestRender() {
					needsRender = true;
				}

				darkModeQuery.addEventListener("change", (event) => {
					labelColor = event.matches ? 0xd4d4d4 : 0x404040;
					linkColor = event.matches ? 0x666666 : 0xaaaaaa;
					for (const nv of nodeVisualsById.values()) {
						nv.label.style.fill = labelColor;
					}
					requestRender();
				});

				function draw() {
					if (!needsRender) return;
					needsRender = false;

					linkLayer.clear();
					for (const l of links) {
						const s = l.source;
						const t = l.target;
						const sx = s.x ?? 0;
						const sy = s.y ?? 0;
						const tx = t.x ?? 0;
						const ty = t.y ?? 0;

						const isHighlighted =
							hoveredNodeId !== null &&
							(s.id === hoveredNodeId || t.id === hoveredNodeId);

						linkLayer.moveTo(sx, sy);
						linkLayer.lineTo(tx, ty);
						const hoveredState = hoveredNodeId === s.id ? s.state : t.state;
						const strokeColor = isHighlighted
							? STATE_META[hoveredState].pixi
							: linkColor;
						linkLayer.stroke({
							width: isHighlighted ? 2.5 : 1.5,
							color: strokeColor,
							alpha: isHighlighted ? 0.7 : 0.2,
						});
					}

					const hoveredNeighbors =
						hoveredNodeId !== null ? neighborsById.get(hoveredNodeId) : null;

					for (const [id, nv] of nodeVisualsById) {
						const x = nv.node.x ?? 0;
						const y = nv.node.y ?? 0;
						const isDisabled = disabledStates.has(nv.node.state);

						nv.glow.position.set(x, y);
						nv.graphic.position.set(x, y);
						nv.label.position.set(x, y + nv.node.radius + 4);

						nv.graphic.filters = isDisabled ? [grayscaleFilter] : [];

						nv.label.alpha = Math.min(1, Math.max(0, (zoom - 0.3) * 1.5));
						nv.label.scale.set(1 / zoom);

						if (hoveredNodeId !== null) {
							const isHovered = id === hoveredNodeId;
							const isConnected = hoveredNeighbors?.has(id) ?? false;
							nv.graphic.alpha =
								isHovered || isConnected ? (isDisabled ? 0.5 : 1) : 0.2;
							nv.glow.alpha =
								isHovered || isConnected ? (isDisabled ? 0.3 : 1) : 0.15;
							nv.label.alpha = isHovered
								? 1
								: isConnected
									? nv.label.alpha * 0.8
									: 0;
						} else {
							nv.graphic.alpha = isDisabled ? 0.4 : 1;
							nv.glow.alpha = isDisabled ? 0.2 : 1;
							nv.label.alpha = isDisabled
								? Math.min(0.3, nv.label.alpha)
								: nv.label.alpha;
						}
					}
				}

				// Boundary clamping + render on tick
				sim.on("tick", () => {
					const bw = container.clientWidth;
					const bh = container.clientHeight;
					const pad = 40;
					for (const n of nodes) {
						const r = n.radius;
						n.x = Math.max(r + pad, Math.min(bw - r - pad, n.x ?? 0));
						n.y = Math.max(r + pad, Math.min(bh - r - pad, n.y ?? 0));
					}
					requestRender();
				});

				app.ticker.add(draw);
				canvas.style.cursor = "grab";

				window.addEventListener("resize", () => {
					sim.force(
						"center",
						forceCenter(container.clientWidth / 2, container.clientHeight / 2),
					);
					sim.alpha(0.3).restart();
					applyTransform();
					requestRender();
				});

				// ---- Reset view button ----
				function resetView() {
					const rcx = container.clientWidth / 2;
					const rcy = container.clientHeight / 2;

					for (const n of nodes) {
						n.fx = null;
						n.fy = null;
						n.x = rcx + (Math.random() - 0.5) * 200;
						n.y = rcy + (Math.random() - 0.5) * 200;
						n.vx = 0;
						n.vy = 0;
					}

					sim.force("center", forceCenter(rcx, rcy));
					sim.alpha(1).restart();

					pan = { x: 0, y: 0 };
					zoom = 1;
					applyTransform();
					requestRender();
				}

				const resetBtn = document.getElementById("reset-view");
				if (resetBtn) {
					resetBtn.addEventListener("click", resetView);
				}

				// ---- Legend filter toggle ----
				const legendBtns =
					document.querySelectorAll<HTMLButtonElement>(".legend-filter");
				for (const btn of legendBtns) {
					btn.addEventListener("click", () => {
						const state = btn.dataset.state;
						if (!state) return;

						if (disabledStates.has(state)) {
							disabledStates.delete(state);
							btn.setAttribute("aria-pressed", "true");
						} else {
							disabledStates.add(state);
							btn.setAttribute("aria-pressed", "false");
						}

						requestRender();
					});
				}
			})();
		</script>
	</Fragment>
</Page>

<style>
	@import "../../styles/media.css";

	#graph-container {
		position: relative;
		flex: 1;
		min-height: 0;
		margin-inline: var(--spacing-fluid-gutter);
		margin-block: var(--spacing-fluid-xs);
		border-radius: var(--radius-xl);
		overflow: hidden;
	}

	#graph {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		touch-action: none;
	}

	.graph-empty {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		pointer-events: none;
		font-size: var(--text-sm);
		color: light-dark(var(--color-neutral-500), var(--color-neutral-400));
	}

	/* Floating panels over the canvas: legend and reset button */
