---
export const prerender = true;

import { getCollection } from "astro:content";
import Picture from "astro/components/Picture.astro";
import cssesc from "cssesc";
import Page from "../../layouts/Page.astro";

const posts = (
	await getCollection("blog", ({ id }) => {
		return id.startsWith("en/");
	})
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Page>
	<Fragment slot="head"> <title>Blog Übersicht</title> </Fragment>
	<Fragment slot="main">
		<h1 class="page-title">Posts</h1>

		<section class="posts">
			{posts.map((post) => (
				<article class="post-card">
					<div class="post-date">
						<time datetime={post.data.date.toDateString()}>
							<span>
								{post.data.date.toLocaleDateString(Astro.currentLocale, {
									year: "numeric",
								})}
							</span>
							<span class="post-date-rule" />
							<span>
								{post.data.date.toLocaleDateString(Astro.currentLocale, {
									month: "short",
									day: "2-digit",
								})}
							</span>
						</time>
					</div>

					<div class="post-cover">
						<Picture
							src={post.data.cover}
							formats={["avif", "webp"]}
							quality={"high"}
							widths={[160, 320, 480, 640, 960, post.data.cover.width]}
							layout="constrained"
							alt={post.data.coverAlt}
							sizes="auto"
							loading="lazy"
						/>
					</div>

					<div class="post-body">
						<div class="post-text">
							<a href={`/${post.id}/`}>
								<h3
									class="post-title"
									style={{
										"view-transition-name": cssesc(post.data.title, {
											isIdentifier: true,
										}),
									}}
								>
									{post.data.title}
								</h3>
							</a>

							{post.data.excerpt && (
								<p class="post-excerpt">{post.data.excerpt}</p>
							)}
						</div>

						<div class="post-actions">
							<a href={`/${post.id}`} class="read-more">
								Read Post
							</a>
						</div>
					</div>
				</article>
			))}
		</section>
	</Fragment>
</Page>

<style>
	@import "../../styles/media.css";

	.page-title {
		text-align: center;
		font-size: var(--text-4xl);
		line-height: var(--text-4xl--line-height);
		font-weight: var(--font-weight-black);
	}

	.posts {
		display: grid;
		gap: var(--spacing-fluid-s);
		padding: var(--spacing-fluid-xs);
	}

	.post-card {
		display: flex;
		transition-property:
			color, background-color, border-color, outline-color,
			text-decoration-color, fill, stroke, opacity, box-shadow, transform,
			translate, scale, rotate, filter, backdrop-filter, display,
			content-visibility, overlay, pointer-events;
		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: var(--default-transition-duration);

		@media (--hover) {
			&:hover {
				background-color: light-dark(
					var(--color-neutral-200-a50),
					var(--color-neutral-800-a50)
				);
			}
		}
	}

	.post-date {
		rotate: 180deg;
		padding: 0.5rem;
		writing-mode: vertical-lr;
		user-select: none;

		& time {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			font-size: var(--text-xs);
			line-height: var(--text-xs--line-height);
			font-weight: var(--font-weight-bold);
			color: light-dark(var(--color-gray-900), var(--color-white));
			text-transform: uppercase;
		}
	}

	.post-date-rule {
		width: 1px;
		flex: 1;
		background-color: light-dark(
			var(--color-gray-900-a10),
			var(--color-white-a10)
		);
	}

	.post-cover {
		display: none;

		@media (--sm) {
			display: block;
			flex-basis: 14rem;
		}

		& :global(img) {
			aspect-ratio: 1;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	.post-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Order matters: in dark mode the border colour also overrides the transparent left border at --sm. */
	.post-text {
		border-inline-start-style: solid;
		border-inline-start-width: 1px;
		border-color: light-dark(var(--color-gray-900-a10), var(--color-white-a10));
		padding: 1rem;

		@media (--sm) {
			/* In dark mode the left border stays visible from sm up, as it always has */
			border-left-color: light-dark(transparent, var(--color-white-a10));
			padding: 1.5rem;
		}
	}

	.post-title {
		font-weight: var(--font-weight-bold);
		color: light-dark(var(--color-gray-900), var(--color-white));
		text-transform: uppercase;
		width: fit-content;
	}

	.post-excerpt {
		margin-top: 0.5rem;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		display: -webkit-box;
		overflow: hidden;
		color: light-dark(var(--color-gray-700), var(--color-gray-200));
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
	}

	.post-actions {
		@media (--sm) {
			display: flex;
			align-items: flex-end;
			justify-content: flex-end;
		}
	}

	.read-more {
		display: block;
		background-color: var(--color-yellow-400);
		padding-inline: 1.25rem;
		padding-block: 0.75rem;
		text-align: center;
		font-weight: var(--font-weight-bold);
		color: var(--color-gray-900);
		font-size: var(--text-xs);
		line-height: var(--text-xs--line-height);
		text-transform: uppercase;
		transition-property:
			color, background-color, border-color, outline-color,
			text-decoration-color, fill, stroke, opacity, box-shadow, transform,
			translate, scale, rotate, filter, backdrop-filter, display,
			content-visibility, overlay, pointer-events;
		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: var(--default-transition-duration);

		@media (--hover) {
			&:hover {
				background-color: var(--color-yellow-500);
			}
		}
	}
</style>
