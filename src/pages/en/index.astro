---
export const prerender = true;

import cssesc from "cssesc";
import PostCover from "../../components/PostCover.astro";
import Page from "../../layouts/Page.astro";
import { getPostUrl, getPublishedPosts } from "../../posts";

const locale = Astro.currentLocale ?? "en";
const posts = await getPublishedPosts(locale);
const canonicalUrl = new URL(`/${locale}/`, Astro.site);
---

<Page>
	<Fragment slot="head">
		<title>Posts — Alexander Niebuhr's Garden</title>
		<meta
			name="description"
			content="Notes and articles on web development, infrastructure, and design in Alexander Niebuhr's digital garden."
		>
		<link rel="canonical" href={canonicalUrl.href}>
	</Fragment>
	<Fragment slot="main">
		<h1 class="page-title">Posts</h1>

		<section class="posts" aria-label="Published posts">
			{posts.map((post) => {
				const postUrl = getPostUrl(post.id);
				const titleTransitionName = cssesc(`post-title-${post.id}`, {
					isIdentifier: true,
				});
				return (
					<article class="post-card">
						<div class="post-date">
							<time datetime={post.data.date.toISOString()}>
								<span>
									{post.data.date.toLocaleDateString(locale, {
										year: "numeric",
									})}
								</span>
								<span class="post-date-rule" aria-hidden="true" />
								<span>
									{post.data.date.toLocaleDateString(locale, {
										month: "short",
										day: "2-digit",
									})}
								</span>
							</time>
						</div>

						<div class="post-cover">
							<PostCover
								postId={post.id}
								src={post.data.cover}
								alt={post.data.coverAlt}
								sizes="auto, 14rem"
							/>
						</div>

						<div class="post-body">
							<div class="post-text">
								<a href={postUrl} class="post-title-link">
									<h2
										class="post-title"
										style={{ "view-transition-name": titleTransitionName }}
									>
										{post.data.title}
									</h2>
								</a>

								{post.data.excerpt && (
									<p class="post-excerpt">{post.data.excerpt}</p>
								)}
							</div>

							<div class="post-actions">
								<a
									href={postUrl}
									class="read-more"
									aria-label={`Read ${post.data.title}`}
								>
									Read Post
								</a>
							</div>
						</div>
					</article>
				);
			})}
		</section>
	</Fragment>
</Page>

<style>
	@import "../../styles/media.css";

	.page-title {
		text-align: center;
		font-size: var(--text-4xl);
		line-height: var(--text-4xl--line-height);
		font-weight: var(--font-weight-black);
	}

	.posts {
		display: grid;
		gap: var(--spacing-fluid-s);
		width: min(100%, 56rem);
		margin-inline: auto;
		padding: var(--spacing-fluid-xs);
	}

	.post-card {
		display: flex;
		transition-property: background-color;
		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: var(--default-transition-duration);

		@media (--hover) {
			&:hover {
				background-color: light-dark(
					var(--color-neutral-200-a50),
					var(--color-neutral-800-a50)
				);
			}
		}
	}

	.post-date {
		rotate: 180deg;
		padding: 0.5rem;
		writing-mode: vertical-lr;
		user-select: none;

		& time {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			font-size: var(--text-xs);
			line-height: var(--text-xs--line-height);
			font-weight: var(--font-weight-bold);
			color: light-dark(var(--color-gray-900), var(--color-white));
			text-transform: uppercase;
		}
	}

	.post-date-rule {
		width: 1px;
		flex: 1;
		background-color: light-dark(
			var(--color-gray-900-a10),
			var(--color-white-a10)
		);
	}

	.post-cover {
		display: none;

		@media (--sm) {
			display: block;
			flex-basis: 14rem;
			flex-shrink: 0;
		}

		& :global(img) {
			aspect-ratio: 1;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	.post-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Order matters: in dark mode the border colour also overrides the transparent left border at --sm. */
	.post-text {
		border-inline-start-style: solid;
		border-inline-start-width: 1px;
		border-color: light-dark(var(--color-gray-900-a10), var(--color-white-a10));
		padding: 1rem;

		@media (--sm) {
			/* In dark mode the left border stays visible from sm up, as it always has */
			border-left-color: light-dark(transparent, var(--color-white-a10));
			padding: 1.5rem;
		}
	}

	.post-title-link {
		display: inline-block;
		border-radius: var(--radius-sm);

		&:focus-visible {
			outline: 2px solid currentcolor;
			outline-offset: 2px;
		}
	}

	.post-title {
		font-weight: var(--font-weight-bold);
		color: light-dark(var(--color-gray-900), var(--color-white));
		text-transform: uppercase;
		width: fit-content;
	}

	.post-excerpt {
		margin-top: 0.5rem;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		display: -webkit-box;
		overflow: hidden;
		color: light-dark(var(--color-gray-700), var(--color-gray-200));
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
	}

	.post-actions {
		@media (--sm) {
			display: flex;
			align-items: flex-end;
			justify-content: flex-end;
		}
	}

	.read-more {
		display: block;
		background-color: var(--color-yellow-400);
		padding-inline: 1.25rem;
		padding-block: 0.75rem;
		text-align: center;
		font-weight: var(--font-weight-bold);
		color: var(--color-gray-900);
		font-size: var(--text-xs);
		line-height: var(--text-xs--line-height);
		text-transform: uppercase;
		transition-property: background-color;
		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: var(--default-transition-duration);

		@media (--hover) {
			&:hover {
				background-color: var(--color-yellow-500);
			}
		}

		&:focus-visible {
			outline: 2px solid currentcolor;
			outline-offset: 2px;
		}
	}
</style>
